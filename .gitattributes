# core.autocrlf=true stores LF and checks out CRLF, but this project writes its
# own text files with an explicit "\n" (pandas lineterminator="\n",
# Path.write_text). Git therefore warns on every `git add` that it intends to
# convert them to CRLF later. Declaring the intent removes the guesswork.
#
# Adding this file causes no diff: the stored blobs are already LF, and an
# existing working tree is left exactly as it is.

.gitattributes text eol=lf
.gitignore     text eol=lf

*.py    text eol=lf
*.csv   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.nc    text eol=lf

# PowerShell is the one thing here that is Windows-only by nature
*.ps1   text eol=crlf

*.png   binary
*.pt    binary
*.npz   binary
